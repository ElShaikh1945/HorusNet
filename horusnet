        daily_label = f"{t(conn, 'daily_auto_label')} [{effective_daily_gb:.2f} GiB]" if is_auto_daily else f"{t(conn, 'daily_custom_label')} [{daily_limit_b / (1024*1024*1024):.2f} GiB]"

        items = [
            ("1", f"[1] {t(conn, 'quota_status')}: [ {status_text} ]", "toggle"),
            ("2", f"[2] {t(conn, 'quota_limit')}: [ {limit_gb:.1f} GiB ]", "set_limit"),
            ("3", f"[3] {t(conn, 'quota_cycle_day')}: [ {t(conn, 'quota_cycle_day_fmt').format(day=start_day)} ]", "set_day"),
            ("4", f"[4] {t(conn, 'daily_limit_setting')}: [ {daily_label} ]", "set_daily_limit"),
            ("5", f"[5] {t(conn, 'daily_warn_setting')}: [ {daily_warn_pct}% ]", "set_daily_warn"),
            ("6", f"[6] {t(conn, 'quota_warn')}: [ {warn_pct}% ]", "set_warn"),
            ("7", f"[7] {t(conn, 'quota_crit')}: [ {crit_pct}% ]", "set_crit"),
            ("8", f"[8] {t(conn, 'quota_test_notif')}", "test_notif"),
            ("0", f"[0] {t(conn, 'setting_back')}", "back")
        ]
        selected_idx = 0

        sys.stdout.write(CURSOR_HIDE)
        sys.stdout.flush()

        try:
            exit_quota = False
            msg_banner = ""
            sys.stdout.write(CLR_CLEAR_SCREEN)
            while True:
                buf = [CLR_HOME]
                buf.append(f"{CLR_BOLD}{th['border']}╔═══════════════════════════════════════════════════════════╗{CLR_RESET}{CLR_CLEAR_LINE}\n")
                buf.append(f"{CLR_BOLD}{th['primary']}║               [ {t(conn, 'quota_title')} ]             ║{CLR_RESET}{CLR_CLEAR_LINE}\n")
                buf.append(f"{CLR_BOLD}{th['border']}╚═══════════════════════════════════════════════════════════╝{CLR_RESET}{CLR_CLEAR_LINE}\n")
                buf.append(f"{th['dim']}  {t(conn, 'nav_hint')}{CLR_RESET}{CLR_CLEAR_LINE}\n\n")

                if msg_banner:
                    buf.append(f"  {CLR_BOLD}{th['accent']}{msg_banner}{CLR_RESET}{CLR_CLEAR_LINE}\n\n")
                    msg_banner = ""

                for idx, (_, label, _) in enumerate(items):
                    if idx == selected_idx:
                        buf.append(f"  {CLR_BOLD}{th['accent']}❯ {CLR_REVERSE} {label} {CLR_RESET}{CLR_CLEAR_LINE}\n")
                    else:
                        buf.append(f"    {label}{CLR_CLEAR_LINE}\n")

                buf.append(f"\n{th['dim']}─────────────────────────────────────────────────────────────{CLR_RESET}{CLR_CLEAR_LINE}\n")
                sys.stdout.write("".join(buf))
                sys.stdout.flush()

                key = get_key()
                triggered_action = None

                if key == 'UP':
                    selected_idx = (selected_idx - 1) % len(items)
                elif key == 'DOWN':
                    selected_idx = (selected_idx + 1) % len(items)
                elif key in ('ESC', 'QUIT', 'CTRL_C'):
                    exit_quota = True
                    break
                elif key.isdigit():
                    for idx, (num, _, action) in enumerate(items):
                        if num == key:
                            selected_idx = idx
                            triggered_action = action
                            break
                elif key in ('ENTER', 'SPACE'):
                    triggered_action = items[selected_idx][2]

                if triggered_action:
                    if triggered_action == "toggle":
                        new_state = 0 if enabled else 1
                        c.execute("UPDATE quota_config SET enabled = ? WHERE id = 1", (new_state,))
                        conn.commit()
                        sync_db_to_settings(conn)
                        break
                    elif triggered_action == "set_limit":
                        new_gb_str = prompt_text_input(conn, t(conn, "quota_prompt_limit"), f"{limit_gb:.0f}")
                        try:
                            new_gb = float(new_gb_str)
                            if new_gb > 0:
                                new_bytes = int(new_gb * 1024 * 1024 * 1024)
                                c.execute("UPDATE quota_config SET total_limit_bytes = ? WHERE id = 1", (new_bytes,))
                                conn.commit()
                                sync_db_to_settings(conn)
                        except ValueError:
                            pass
                        break
                    elif triggered_action == "set_day":
                        new_day_str = prompt_text_input(conn, t(conn, "quota_prompt_day"), str(start_day))
                        try:
                            new_day = int(new_day_str)
                            if 1 <= new_day <= 31:
                                c.execute("UPDATE quota_config SET cycle_start_day = ? WHERE id = 1", (new_day,))
                                conn.commit()
                                sync_db_to_settings(conn)
                        except ValueError:
                            pass
                        break
                    elif triggered_action == "set_daily_limit":
                        def_val = "0" if is_auto_daily else f"{daily_limit_b / (1024*1024*1024):.2f}"
                        new_dl_str = prompt_text_input(conn, t(conn, "quota_prompt_daily_limit"), def_val)
                        try:
                            val_f = float(new_dl_str)
                            if val_f <= 0:
                                c.execute("UPDATE quota_config SET daily_limit_bytes = 0 WHERE id = 1")
                            else:
                                new_b = int(val_f * 1024 * 1024 * 1024)
                                c.execute("UPDATE quota_config SET daily_limit_bytes = ? WHERE id = 1", (new_b,))
                            conn.commit()
                            sync_db_to_settings(conn)
                        except ValueError:
                            pass
                        break
                    elif triggered_action == "set_daily_warn":
                        new_dw_str = prompt_text_input(conn, t(conn, "quota_prompt_daily_warn"), str(daily_warn_pct))
                        try:
                            new_dw = int(new_dw_str)
                            if 1 <= new_dw <= 100:
                                c.execute("UPDATE quota_config SET daily_warn_percent = ? WHERE id = 1", (new_dw,))
                                conn.commit()
                                sync_db_to_settings(conn)
                        except ValueError:
                            pass
                        break
                    elif triggered_action == "set_warn":
                        new_w_str = prompt_text_input(conn, t(conn, "quota_prompt_warn"), str(warn_pct))
                        try:
                            new_w = int(new_w_str)
                            if 1 <= new_w <= 100:
                                c.execute("UPDATE quota_config SET warn_threshold_percent = ? WHERE id = 1", (new_w,))
                                conn.commit()
                                sync_db_to_settings(conn)
                        except ValueError:
                            pass
                        break
                    elif triggered_action == "set_crit":
                        new_c_str = prompt_text_input(conn, t(conn, "quota_prompt_crit"), str(crit_pct))
                        try:
                            new_c = int(new_c_str)
                            if 1 <= new_c <= 100:
                                c.execute("UPDATE quota_config SET crit_threshold_percent = ? WHERE id = 1", (new_c,))
                                conn.commit()
                                sync_db_to_settings(conn)
                        except ValueError:
                            pass
                        break
                    elif triggered_action == "test_notif":
                        try:
                            subprocess.run([
                                "notify-send", "-u", "normal", "-a", "HorusNet",
                                t(conn, "quota_test_notif_title"),
                                t(conn, "quota_test_notif_msg")
                            ], check=False)
                            msg_banner = f"● {t(conn, 'notif_sent')}"
                        except Exception as e:
                            msg_banner = f"Notification error: {e}"
                    elif triggered_action == "back":
                        exit_quota = True
                        break

            if exit_quota:
                break
        finally:
            sys.stdout.write(CURSOR_SHOW)
            sys.stdout.flush()

