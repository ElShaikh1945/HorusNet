def live_monitor(conn, target_iface=None):
    th = get_theme(conn)
    print(f"\n{CLR_BOLD}{th['primary']}[ {t(conn, 'live_title')} ]{CLR_RESET}")
    print(f"{th['dim']}{t(conn, 'live_hint')}{CLR_RESET}\n")

    def get_totals():
        data = read_proc_net_dev()
        if target_iface:
            v = data.get(target_iface, {"rx": 0, "tx": 0})
            return v["rx"], v["tx"]
        else:
            return sum(v["rx"] for v in data.values()), sum(v["tx"] for v in data.values())

    last_rx, last_tx = get_totals()
    last_time = time.time()
    
    target_name = f"{t(conn, 'iface_prefix')} {target_iface}" if target_iface else t(conn, "all_ifaces")
    print(f"{t(conn, 'target')}: {CLR_BOLD}{target_name}{CLR_RESET}\n")

    fd = sys.stdin.fileno() if sys.stdin.isatty() else None
    old_settings = termios.tcgetattr(fd) if fd else None

    if fd:
        tty.setraw(fd)

    try:
        while True:
            if fd:
                r, _, _ = select.select([fd], [], [], 1.0)
                if r:
                    ch = os.read(fd, 10)
                    if ch in (b'\x1b', b'q', b'Q', b'\x03', b'\r', b'\n'):
                        break
            else:
                time.sleep(1.0)

            now_time = time.time()
            curr_rx, curr_tx = get_totals()
            
            elapsed = now_time - last_time
            if elapsed <= 0:
                elapsed = 1.0

            rx_speed = (curr_rx - last_rx) / elapsed
            tx_speed = (curr_tx - last_tx) / elapsed

            last_rx, last_tx = curr_rx, curr_tx
            last_time = now_time

            max_bar_width = 18
            rx_bar_len = min(max_bar_width, int((rx_speed / (5 * 1024 * 1024)) * max_bar_width))
            rx_bar = "█" * rx_bar_len + "░" * (max_bar_width - rx_bar_len)

            tx_bar_len = min(max_bar_width, int((tx_speed / (2 * 1024 * 1024)) * max_bar_width))
            tx_bar = "█" * tx_bar_len + "░" * (max_bar_width - tx_bar_len)

            sys.stdout.write(f"\r▼ [{th['accent']}{rx_bar}{CLR_RESET}] {format_rate(rx_speed):>11}   "
                             f"▲ [{th['secondary']}{tx_bar}{CLR_RESET}] {format_rate(tx_speed):>11}")
            sys.stdout.flush()

    except KeyboardInterrupt:
        pass
    finally:
        if fd and old_settings:
            termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
        print(f"\n\n{th['dim']}{t(conn, 'goodbye')}{CLR_RESET}")

# ----------------------------------------------------
# Responsive Terminal Key Engine
# ----------------------------------------------------

def get_key():
    if not sys.stdin.isatty():
        return 'ESC'
    fd = sys.stdin.fileno()
    old_settings = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        first = os.read(fd, 1)
        if not first:
            return None
        if first == b'\x1b':
            r, _, _ = select.select([fd], [], [], 0.05)
            if r:
                rest = os.read(fd, 16)
                seq = first + rest
                if seq in (b'\x1b[', b'\x1bO'):
                    r2, _, _ = select.select([fd], [], [], 0.05)
                    if r2:
                        seq += os.read(fd, 8)
                if seq in (b'\x1b[A', b'\x1bOA', b'\x1b[1;2A', b'\x1b[1;5A'):
                    return 'UP'
                elif seq in (b'\x1b[B', b'\x1bOB', b'\x1b[1;2B', b'\x1b[1;5B'):
                    return 'DOWN'
                elif seq in (b'\x1b[C', b'\x1bOC'):
                    return 'RIGHT'
                elif seq in (b'\x1b[D', b'\x1bOD'):
                    return 'LEFT'
                return 'ESC'
            else:
                return 'ESC'

        if first in (b'\r', b'\n'):
            return 'ENTER'
        elif first == b' ':
            return 'SPACE'
        elif first == b'\x03':
            return 'CTRL_C'
        elif first in (b'\x7f', b'\x08'):
            return 'BACK'
        elif first in (b'q', b'Q'):
            return 'QUIT'
        elif first in (b'k', b'K'):
            return 'UP'
        elif first in (b'j', b'J'):
            return 'DOWN'
        elif first.isdigit():
            return first.decode('utf-8', errors='ignore')
        return first.decode('utf-8', errors='ignore')
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)

def wait_for_enter_or_q(conn):
    th = get_theme(conn)
    print(f"\n{th['dim']}{t(conn, 'press_enter_back')}{CLR_RESET}", end="", flush=True)
    while True:
        k = get_key()
        if k in ('ENTER', 'SPACE', 'ESC', 'BACK'):
            return True
        elif k in ('QUIT', 'CTRL_C'):
            return False

