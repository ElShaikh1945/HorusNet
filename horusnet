            if peak_hour is not None and peak_val > 0:
                print(f"\n{CLR_BOLD}⚡ {t(conn, 'peak_hour')}:{CLR_RESET} {peak_hour:02d}:00 - {peak_hour+1:02d}:00 ({CLR_BOLD}{th['accent']}{format_bytes(peak_val)}{CLR_RESET})")

