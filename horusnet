def load_locales():
    os.makedirs(LOCALES_DIR, exist_ok=True)
    en_file = os.path.join(LOCALES_DIR, "en.json")
    ar_file = os.path.join(LOCALES_DIR, "ar.json")

    if not os.path.exists(en_file):
        try:
            with open(en_file, "w", encoding="utf-8") as f:
                json.dump(DEFAULT_STRINGS.get("en", {}), f, indent=2, ensure_ascii=False)
        except Exception:
            pass
    if not os.path.exists(ar_file):
        try:
            with open(ar_file, "w", encoding="utf-8") as f:
                json.dump(DEFAULT_STRINGS.get("ar", {}), f, indent=2, ensure_ascii=False)
        except Exception:
            pass

    loaded = {k: dict(v) for k, v in DEFAULT_STRINGS.items()}
    try:
        for fname in os.listdir(LOCALES_DIR):
            if fname.endswith(".json"):
                lang_code = fname[:-5]
                filepath = os.path.join(LOCALES_DIR, fname)
                try:
                    with open(filepath, "r", encoding="utf-8") as f:
                        d = json.load(f)
                        if isinstance(d, dict):
                            if lang_code not in loaded:
                                loaded[lang_code] = {}
                            loaded[lang_code].update(d)
                except Exception:
                    pass
    except Exception:
        pass
    return loaded

