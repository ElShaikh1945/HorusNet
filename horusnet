def export_csv(conn, filepath=None):
    if not filepath:
        filepath = os.path.expanduser("~/horusnet_daily_report.csv")
    filepath = os.path.abspath(os.path.expanduser(filepath))
    c = conn.cursor()
    c.execute("""
        SELECT date, interface, rx, tx, (rx + tx) as total
        FROM daily_stats
        ORDER BY date DESC, interface ASC
    """)
    rows = c.fetchall()

    with open(filepath, "w", encoding="utf-8", newline="") as f:
        writer = csv.writer(f)
        writer.writerow(["Date", "Interface", "Download_Bytes", "Upload_Bytes", "Total_Bytes", "Download_Formatted", "Upload_Formatted", "Total_Formatted"])
        for d, iface, rx, tx, tot in rows:
            writer.writerow([d, iface, rx, tx, tot, format_bytes(rx), format_bytes(tx), format_bytes(tot)])
    return filepath

def export_json(conn, filepath=None):
    if not filepath:
        filepath = os.path.expanduser("~/horusnet_report.json")
    filepath = os.path.abspath(os.path.expanduser(filepath))
    c = conn.cursor()

    branding = load_branding()
    quota = get_quota_status(conn)

    c.execute("SELECT date, interface, rx, tx FROM daily_stats ORDER BY date DESC")
    daily = [{"date": r[0], "interface": r[1], "rx": r[2], "tx": r[3], "total": r[2] + r[3]} for r in c.fetchall()]

    c.execute("SELECT date, hour, interface, rx, tx FROM hourly_stats ORDER BY date DESC, hour ASC")
    hourly = [{"date": r[0], "hour": r[1], "interface": r[2], "rx": r[3], "tx": r[4], "total": r[3] + r[4]} for r in c.fetchall()]

    data = {
        "generator": branding.get("name", "HorusNet"),
        "version": VERSION,
        "exported_at": datetime.now().isoformat(),
        "quota": quota,
        "daily_stats": daily,
        "hourly_stats": hourly
    }

    with open(filepath, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
    return filepath

def export_html(conn, filepath=None):
    if not filepath:
        filepath = os.path.expanduser("~/horusnet_report.html")
    filepath = os.path.abspath(os.path.expanduser(filepath))

    branding = load_branding()
    quota = get_quota_status(conn)
    c = conn.cursor()

    today = datetime.now().strftime("%Y-%m-%d")
    yesterday = (datetime.now() - timedelta(days=1)).strftime("%Y-%m-%d")
    this_month = datetime.now().strftime("%Y-%m")

    # Metrics
    c.execute("SELECT SUM(rx), SUM(tx) FROM daily_stats WHERE date = ?", (today,))
    row = c.fetchone()
    today_rx, today_tx = (row[0] or 0), (row[1] or 0)

    c.execute("SELECT SUM(rx), SUM(tx) FROM daily_stats WHERE date = ?", (yesterday,))
    row = c.fetchone()
    yest_rx, yest_tx = (row[0] or 0), (row[1] or 0)

    c.execute("SELECT SUM(rx), SUM(tx) FROM daily_stats WHERE date LIKE ?", (f"{this_month}%",))
    row = c.fetchone()
    month_rx, month_tx = (row[0] or 0), (row[1] or 0)

    c.execute("SELECT SUM(rx), SUM(tx) FROM daily_stats")
    row = c.fetchone()
    life_rx, life_tx = (row[0] or 0), (row[1] or 0)

    # Hourly for today
    c.execute("SELECT hour, SUM(rx + tx) FROM hourly_stats WHERE date = ? GROUP BY hour ORDER BY hour ASC", (today,))
    h_data = {r[0]: r[1] for r in c.fetchall()}
    max_h = max(h_data.values()) if h_data and max(h_data.values()) > 0 else 1

    chart_bars_html = ""
    for h in range(24):
        val = h_data.get(h, 0)
        pct = (val / max_h * 100) if max_h > 0 else 0
