def show_applications(conn):
    """Main Applications View: lists all apps with network activity, showing today's usage and daily active duration."""
    update_traffic(conn)
    th = get_theme(conn)
    selected_idx = 0
    fetch_apps = True
    apps_list = []
    need_full_clear = True

    sys.stdout.write(CURSOR_HIDE)
    sys.stdout.flush()

    while True:
        if fetch_apps:
            apps_dict = get_process_network_info()
            update_apps_history(conn, apps_dict)
            today = datetime.now().strftime("%Y-%m-%d")
            c = conn.cursor()

            # Gather apps from both live processes and today's app_daily_stats
            c.execute("SELECT app_name, rx, tx, active_seconds FROM app_daily_stats WHERE date = ?", (today,))
            today_db_apps = {row[0]: {"rx": row[1], "tx": row[2], "active_seconds": row[3]} for row in c.fetchall()}

            combined_names = set(apps_dict.keys()) | set(today_db_apps.keys())
            apps_list = []

            now_dt = datetime.now()
            midnight = now_dt.replace(hour=0, minute=0, second=0, microsecond=0)
            sec_since_midnight = max(1, int((now_dt - midnight).total_seconds()))

            for name in combined_names:
                live_data = apps_dict.get(name, {})
                db_data = today_db_apps.get(name, {})

                pids = live_data.get("pids", set())
                is_running = len(pids) > 0

                t_rx = max(db_data.get("rx", 0), live_data.get("net_rx", 0))
                t_tx = max(db_data.get("tx", 0), live_data.get("net_tx", 0))
                t_tot = t_rx + t_tx

                proc_runtime = max((get_pid_runtime(p) for p in pids), default=0) if pids else 0
                act_sec = max(db_data.get("active_seconds", 0), min(proc_runtime, sec_since_midnight))

                apps_list.append({
                    "name": name,
                    "pids": pids,
                    "exe_path": live_data.get("exe_path", "unknown"),
                    "cmdline": live_data.get("cmdline", ""),
                    "is_running": is_running,
                    "today_rx": t_rx,
                    "today_tx": t_tx,
                    "today_total": t_tot,
                    "active_seconds": act_sec
