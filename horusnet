def get_quota_status(conn):
    c = conn.cursor()
    c.execute("""
        SELECT enabled, period_type, cycle_start_day, total_limit_bytes,
               warn_threshold_percent, crit_threshold_percent, last_warned_level, last_warned_cycle,
               daily_limit_bytes, daily_warn_percent, last_warned_daily_date, last_warned_daily_level
        FROM quota_config WHERE id = 1
    """)
    row = c.fetchone()
    if not row or not row[0]:
        return {"enabled": False}

    (enabled, period_type, start_day, limit_bytes, warn_pct, crit_pct,
     last_warn_lvl, last_warn_cycle, daily_limit_b, daily_warn_pct,
     last_daily_date, last_daily_lvl) = row

    today_dt = datetime.now()

    if period_type == "daily":
        cycle_start_str = today_dt.strftime("%Y-%m-%d")
        next_cycle_dt = today_dt + timedelta(days=1)
        cycle_start_dt = today_dt.date()
        days_left = 1
        days_in_cycle = 1
    else:
        day_now = today_dt.day
        year_now = today_dt.year
        month_now = today_dt.month

        if day_now >= start_day:
            max_days = calendar.monthrange(year_now, month_now)[1]
            actual_day = min(start_day, max_days)
            cycle_start_dt = date(year_now, month_now, actual_day)

            next_m = (month_now % 12) + 1
            next_y = year_now + (1 if month_now == 12 else 0)
            next_max_days = calendar.monthrange(next_y, next_m)[1]
            next_cycle_dt = date(next_y, next_m, min(start_day, next_max_days))
        else:
            prev_m = 12 if month_now == 1 else month_now - 1
            prev_y = year_now - 1 if month_now == 1 else year_now
            prev_max_days = calendar.monthrange(prev_y, prev_m)[1]
            cycle_start_dt = date(prev_y, prev_m, min(start_day, prev_max_days))

            next_max_days = calendar.monthrange(year_now, month_now)[1]
            next_cycle_dt = date(year_now, month_now, min(start_day, next_max_days))

        cycle_start_str = cycle_start_dt.strftime("%Y-%m-%d")
        days_left = (next_cycle_dt - today_dt.date()).days
        days_in_cycle = max(1, (next_cycle_dt - cycle_start_dt).days)

    c.execute("SELECT SUM(rx), SUM(tx) FROM daily_stats WHERE date >= ?", (cycle_start_str,))
    rx_tx = c.fetchone()
    used_bytes = (rx_tx[0] or 0) + (rx_tx[1] or 0)
    remaining_bytes = max(0, limit_bytes - used_bytes)
    percentage = (used_bytes / limit_bytes * 100) if limit_bytes > 0 else 0

    # Daily Quota Calculation (Default: monthly quota divided by days in billing cycle)
    is_daily_auto = (daily_limit_b == 0 or daily_limit_b is None)
    effective_daily_limit = (limit_bytes // days_in_cycle) if is_daily_auto else daily_limit_b

    today_str = today_dt.strftime("%Y-%m-%d")
    c.execute("SELECT SUM(rx), SUM(tx) FROM daily_stats WHERE date = ?", (today_str,))
    today_rx_tx = c.fetchone()
    today_used_bytes = (today_rx_tx[0] or 0) + (today_rx_tx[1] or 0)
    daily_remaining_bytes = max(0, effective_daily_limit - today_used_bytes)
    daily_percentage = (today_used_bytes / effective_daily_limit * 100) if effective_daily_limit > 0 else 0

    return {
        "enabled": True,
        "period_type": period_type,
        "cycle_id": cycle_start_str,
        "start_day": start_day,
        "limit": limit_bytes,
        "used": used_bytes,
        "remaining": remaining_bytes,
        "percentage": percentage,
        "days_left": days_left,
        "days_in_cycle": days_in_cycle,
        "warn_threshold": warn_pct,
        "crit_threshold": crit_pct,
        "last_warned_level": last_warn_lvl,
        "last_warned_cycle": last_warn_cycle,
        "daily_limit": effective_daily_limit,
        "daily_used": today_used_bytes,
        "daily_remaining": daily_remaining_bytes,
        "daily_percentage": daily_percentage,
        "daily_is_auto": is_daily_auto,
        "daily_warn_threshold": daily_warn_pct,
        "last_warned_daily_date": last_daily_date,
        "last_warned_daily_level": last_daily_lvl
    }

def check_and_notify_quota(conn, q_stat):
    if not q_stat or not q_stat.get("enabled"):
        return

    used_pct = q_stat["percentage"]
    cycle_id = q_stat["cycle_id"]
    last_level = q_stat["last_warned_level"]
    last_cycle = q_stat["last_warned_cycle"]
    warn_thr = q_stat["warn_threshold"]
    crit_thr = q_stat["crit_threshold"]

    if last_cycle != cycle_id:
        last_level = 0

    c = conn.cursor()

    # Monthly notifications
    if used_pct >= crit_thr and last_level < crit_thr:
        try:
            subprocess.run([
                "notify-send", "-u", "critical", "-a", "HorusNet",
                "HorusNet - Critical Quota Warning",
                f"You have used {used_pct:.1f}% of your data quota ({format_bytes(q_stat['used'])} / {format_bytes(q_stat['limit'])}).\nRemaining: {format_bytes(q_stat['remaining'])}"
            ], check=False)
            c.execute("UPDATE quota_config SET last_warned_level = ?, last_warned_cycle = ? WHERE id = 1", (crit_thr, cycle_id))
            conn.commit()
        except Exception:
            pass

    elif used_pct >= warn_thr and last_level < warn_thr:
        try:
            subprocess.run([
                "notify-send", "-u", "normal", "-a", "HorusNet",
                "HorusNet - Quota Alert",
                f"Warning: You have reached {used_pct:.1f}% of your data quota ({format_bytes(q_stat['used'])} / {format_bytes(q_stat['limit'])})."
            ], check=False)
            c.execute("UPDATE quota_config SET last_warned_level = ?, last_warned_cycle = ? WHERE id = 1", (warn_thr, cycle_id))
            conn.commit()
        except Exception:
            pass

    # Daily limit notifications
    today_str = datetime.now().strftime("%Y-%m-%d")
    daily_used = q_stat["daily_used"]
    daily_limit = q_stat["daily_limit"]
    daily_pct = q_stat["daily_percentage"]
    daily_warn_thr = q_stat["daily_warn_threshold"]
    last_daily_date = q_stat["last_warned_daily_date"]
    last_daily_lvl = q_stat["last_warned_daily_level"]

    if last_daily_date != today_str:
        last_daily_lvl = 0

    if daily_limit > 0:
        if daily_pct >= 100 and last_daily_lvl < 100:
            try:
                over_bytes = daily_used - daily_limit
                subprocess.run([
                    "notify-send", "-u", "critical", "-a", "HorusNet",
                    "HorusNet - Daily Limit Exceeded",
                    f"You have used {daily_pct:.1f}% and exceeded your daily limit ({format_bytes(daily_used)} / {format_bytes(daily_limit)}).\nOver limit by: +{format_bytes(over_bytes)}"
                ], check=False)
                c.execute("UPDATE quota_config SET last_warned_daily_level = 100, last_warned_daily_date = ? WHERE id = 1", (today_str,))
                conn.commit()
            except Exception:
                pass
        elif daily_pct >= daily_warn_thr and last_daily_lvl < daily_warn_thr:
            try:
                subprocess.run([
                    "notify-send", "-u", "normal", "-a", "HorusNet",
                    "HorusNet - Daily Usage Alert",
                    f"Alert: You have reached {daily_pct:.1f}% of your recommended daily limit ({format_bytes(daily_used)} / {format_bytes(daily_limit)}).\nRemaining today: {format_bytes(q_stat['daily_remaining'])}"
                ], check=False)
                c.execute("UPDATE quota_config SET last_warned_daily_level = ?, last_warned_daily_date = ? WHERE id = 1", (daily_warn_thr, today_str))
                conn.commit()
            except Exception:
                pass

def import_vnstat_history(conn):
    if not os.path.exists(VNSTAT_DB):
        return
    if get_config_val(conn, "vnstat_imported") == "1":
        return

    try:
        v_conn = sqlite3.connect(VNSTAT_DB)
        v_c = v_conn.cursor()
        
        # Daily stats
        v_c.execute("SELECT interface.name, day.date, day.rx, day.tx FROM day JOIN interface ON day.interface = interface.id")
        c = conn.cursor()
        for iface, date_str, rx, tx in v_c.fetchall():
            if rx > 0 or tx > 0:
                c.execute("""
                    INSERT INTO daily_stats (date, interface, rx, tx)
                    VALUES (?, ?, ?, ?)
                    ON CONFLICT(date, interface) DO UPDATE SET
                    rx = MAX(rx, excluded.rx),
                    tx = MAX(tx, excluded.tx)
                """, (date_str, iface, rx, tx))

        # Hourly stats
        v_c.execute("SELECT interface.name, hour.date, hour.rx, hour.tx FROM hour JOIN interface ON hour.interface = interface.id")
        for iface, dt_str, rx, tx in v_c.fetchall():
            if rx > 0 or tx > 0:
                d_str = dt_str[:10]
                h_int = int(dt_str[11:13])
                c.execute("""
                    INSERT INTO hourly_stats (date, hour, interface, rx, tx)
                    VALUES (?, ?, ?, ?, ?)
                    ON CONFLICT(date, hour, interface) DO UPDATE SET
                    rx = MAX(rx, excluded.rx),
                    tx = MAX(tx, excluded.tx)
                """, (d_str, h_int, iface, rx, tx))

        v_conn.close()
        set_config_val(conn, "vnstat_imported", "1")
    except Exception:
        pass

def update_traffic(conn):
    import_vnstat_history(conn)
    current_net = read_proc_net_dev()
    boot_id = get_boot_id()
    now_dt = datetime.now()
    today = now_dt.strftime("%Y-%m-%d")
    current_hour = now_dt.hour
    now_ts = time.time()
    
    c = conn.cursor()
    c.execute("SELECT interface, boot_id, last_rx, last_tx FROM state")
    saved_states = {row[0]: {"boot_id": row[1], "last_rx": row[2], "last_tx": row[3]} for row in c.fetchall()}

    for iface, counters in current_net.items():
        curr_rx = counters["rx"]
        curr_tx = counters["tx"]
        
        if iface in saved_states:
            prev = saved_states[iface]
            if prev["boot_id"] == boot_id and curr_rx >= prev["last_rx"] and curr_tx >= prev["last_tx"]:
                delta_rx = curr_rx - prev["last_rx"]
                delta_tx = curr_tx - prev["last_tx"]
            else:
                delta_rx = curr_rx
                delta_tx = curr_tx
        else:
            delta_rx = curr_rx
            delta_tx = curr_tx

        if delta_rx > 0 or delta_tx > 0:
            c.execute("""
                INSERT INTO daily_stats (date, interface, rx, tx)
                VALUES (?, ?, ?, ?)
                ON CONFLICT(date, interface) DO UPDATE SET
                rx = rx + excluded.rx,
                tx = tx + excluded.tx
            """, (today, iface, delta_rx, delta_tx))

            c.execute("""
                INSERT INTO hourly_stats (date, hour, interface, rx, tx)
                VALUES (?, ?, ?, ?, ?)
                ON CONFLICT(date, hour, interface) DO UPDATE SET
                rx = rx + excluded.rx,
                tx = tx + excluded.tx
            """, (today, current_hour, iface, delta_rx, delta_tx))

        c.execute("""
            INSERT INTO state (interface, boot_id, last_rx, last_tx, updated_at)
            VALUES (?, ?, ?, ?, ?)
            ON CONFLICT(interface) DO UPDATE SET
            boot_id = excluded.boot_id,
            last_rx = excluded.last_rx,
            last_tx = excluded.last_tx,
            updated_at = excluded.updated_at
        """, (iface, boot_id, curr_rx, curr_tx, now_ts))

    conn.commit()

    # Track application history and daily duration
    update_apps_history(conn)

    q_stat = get_quota_status(conn)
    check_and_notify_quota(conn, q_stat)

