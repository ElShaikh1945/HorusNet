                    warn_threshold_percent = ?, crit_threshold_percent = ?,
                    daily_limit_bytes = ?, daily_warn_percent = ?
                WHERE id = 1
            """, (q_enabled, q_limit_b, q_day, q_warn, q_crit, q_daily_b, q_daily_warn))
        conn.commit()
