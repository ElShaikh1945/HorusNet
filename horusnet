def export_reports_menu(conn):
    th = get_theme(conn)
    items = [
        ("1", f"[1] {t(conn, 'export_html_btn')}", "html"),
        ("2", f"[2] {t(conn, 'export_csv_btn')}", "csv"),
        ("3", f"[3] {t(conn, 'export_json_btn')}", "json"),
        ("0", f"[0] {t(conn, 'setting_back')}", "back")
    ]
    selected_idx = 0
    msg_banner = ""

    sys.stdout.write(CURSOR_HIDE)
    sys.stdout.write(CLR_CLEAR_SCREEN)
    sys.stdout.flush()

    while True:
        buf = [CLR_HOME]
        buf.append(f"{CLR_BOLD}{th['border']}╔═══════════════════════════════════════════════════════════╗{CLR_RESET}{CLR_CLEAR_LINE}\n")
        buf.append(f"{CLR_BOLD}{th['primary']}║               [ {t(conn, 'export_title')} ]             ║{CLR_RESET}{CLR_CLEAR_LINE}\n")
        buf.append(f"{CLR_BOLD}{th['border']}╚═══════════════════════════════════════════════════════════╝{CLR_RESET}{CLR_CLEAR_LINE}\n")
        buf.append(f"{th['dim']}  {t(conn, 'nav_hint')}{CLR_RESET}{CLR_CLEAR_LINE}\n\n")

        if msg_banner:
            buf.append(f"  {CLR_BOLD}{th['accent']}{msg_banner}{CLR_RESET}{CLR_CLEAR_LINE}\n\n")
            msg_banner = ""

        for idx, (_, label, _) in enumerate(items):
            if idx == selected_idx:
                buf.append(f"  {CLR_BOLD}{th['accent']}❯ {CLR_REVERSE} {label} {CLR_RESET}{CLR_CLEAR_LINE}\n")
            else:
                buf.append(f"    {label}{CLR_CLEAR_LINE}\n")

        buf.append(f"\n{th['dim']}─────────────────────────────────────────────────────────────{CLR_RESET}{CLR_CLEAR_LINE}\n")
        sys.stdout.write("".join(buf))
        sys.stdout.flush()

        key = get_key()
        triggered = None

        if key == 'UP':
            selected_idx = (selected_idx - 1) % len(items)
        elif key == 'DOWN':
            selected_idx = (selected_idx + 1) % len(items)
        elif key in ('ESC', 'QUIT', 'CTRL_C'):
            break
        elif key.isdigit():
            for idx, (num, _, action) in enumerate(items):
                if num == key:
                    selected_idx = idx
                    triggered = action
                    break
        elif key in ('ENTER', 'SPACE'):
            triggered = items[selected_idx][2]

        if triggered:
            if triggered == "back":
                break
            elif triggered == "html":
                path = export_html(conn)
                msg_banner = f"{t(conn, 'export_success')} {path}"
            elif triggered == "csv":
                path = export_csv(conn)
                msg_banner = f"{t(conn, 'export_success')} {path}"
            elif triggered == "json":
                path = export_json(conn)
                msg_banner = f"{t(conn, 'export_success')} {path}"

