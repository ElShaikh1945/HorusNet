        if key == 'UP':
            selected_idx = (selected_idx - 1) % len(apps_list)
        elif key == 'DOWN':
            selected_idx = (selected_idx + 1) % len(apps_list)
        elif key in ('r', 'R'):
            fetch_apps = True
            need_full_clear = True
        elif key in ('ESC', 'QUIT', 'CTRL_C'):
            break
        elif key.isdigit():
            idx_num = int(key) - 1
            if 0 <= idx_num < len(apps_list):
                selected_idx = idx_num
