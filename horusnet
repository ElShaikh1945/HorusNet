        CREATE TABLE IF NOT EXISTS app_state (
            app_name TEXT PRIMARY KEY,
            last_rx INTEGER DEFAULT 0,
            last_tx INTEGER DEFAULT 0,
            last_seen REAL
        )
    """)
    conn.commit()

    # Synchronize settings.json into SQLite if settings.json exists
    try:
        s = load_settings()
        if "theme" in s:
            c.execute("INSERT OR REPLACE INTO config (key, val) VALUES ('theme', ?)", (s["theme"],))
        if "language" in s:
            c.execute("INSERT OR REPLACE INTO config (key, val) VALUES ('language', ?)", (s["language"],))
        q = s.get("quota", {})
        if q:
            q_enabled = 1 if q.get("enabled", True) else 0
            q_limit_b = int(float(q.get("total_limit_gb", 30.0)) * 1024 * 1024 * 1024)
            q_day = int(q.get("cycle_start_day", 16))
