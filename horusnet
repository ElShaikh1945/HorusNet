def main():
    parser = argparse.ArgumentParser(
        prog="netusage",
        description="HorusNet / NetUsage - Network Traffic Monitor & Logger",
        formatter_class=argparse.RawTextHelpFormatter
    )
    parser.add_argument("-d", "--days", nargs="?", const=14, type=int, help="Show daily traffic history")
    parser.add_argument("-m", "--months", action="store_true", help="Show monthly traffic history")
    parser.add_argument("-H", "--hourly", nargs="?", const="TODAY", type=str, help="Show hourly breakdown and chart")
    parser.add_argument("-a", "--apps", nargs="?", const="ALL", type=str, help="Show active applications network inspection")
    parser.add_argument("-i", "--interfaces", action="store_true", help="Show per-interface details")
    parser.add_argument("-l", "--live", nargs="?", const="ALL", type=str, help="Live bandwidth monitor")
    parser.add_argument("-e", "--export", nargs="+", help="Export network traffic reports: --export {csv,json,html} [file_path]")
    parser.add_argument("-o", "--output", type=str, help="Output file path for exported report")
    parser.add_argument("--menu", action="store_true", help="Launch interactive menu")
    parser.add_argument("--update", action="store_true", help=argparse.SUPPRESS)

    args = parser.parse_args()
    conn = get_db()

    if args.update:
        update_traffic(conn)
        conn.close()
        return

    if args.export:
        fmt = args.export[0].lower()
        target_path = args.export[1] if len(args.export) > 1 else (args.output or None)
        if fmt not in ("csv", "json", "html"):
            print(t(conn, "export_unsupported").format(fmt=fmt))
            conn.close()
            return

        if fmt == "csv":
            path = export_csv(conn, target_path)
        elif fmt == "json":
            path = export_json(conn, target_path)
        elif fmt == "html":
            path = export_html(conn, target_path)

        print(t(conn, "export_success_cli").format(fmt=fmt.upper(), path=path))
        conn.close()
        return

    if args.days is not None:
        show_daily(conn, limit=args.days)
    elif args.months:
        show_monthly(conn)
    elif args.hourly is not None:
        target_d = None if args.hourly == "TODAY" else args.hourly
        show_hourly(conn, target_date=target_d)
    elif args.apps is not None:
        if args.apps == "ALL":
            show_applications(conn)
        else:
            apps_dict = get_process_network_info()
            target_app = None
            for name, data in apps_dict.items():
                if name.lower() == args.apps.lower():
                    target_app = data
                    break
            if not target_app:
                c = conn.cursor()
                c.execute("SELECT app_name FROM app_daily_stats WHERE LOWER(app_name) = ? LIMIT 1", (args.apps.lower(),))
                db_match = c.fetchone()
                if db_match:
                    target_app = {"name": db_match[0], "pids": set(), "exe_path": "Inactive"}
            if target_app:
                inspect_app_details(conn, target_app)
            else:
                print(t(conn, "app_not_found_cli").format(app=args.apps))
    elif args.interfaces:
        show_interfaces(conn)
    elif args.live is not None:
        iface = None if args.live == "ALL" else args.live
        live_monitor(conn, iface)
    else:
        if sys.stdin.isatty():
            interactive_menu(conn)
        else:
            show_summary(conn)

    conn.close()

if __name__ == "__main__":
    main()
