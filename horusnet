def get_process_network_info():
    """Discovers running apps with active network sockets and reads their real network transfer metrics via ss -tupina"""
    apps = {}
    try:
        res = subprocess.run(["ss", "-tupina"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
        lines = res.stdout.strip().split("\n")
        current_sock = None

        for line in lines:
            if line.startswith('\t') or line.startswith('   '):
                if current_sock:
                    rx_m = re.search(r'bytes_received:(\d+)', line)
                    tx_m = re.search(r'bytes_sent:(\d+)', line)
                    if rx_m:
                        current_sock['rx'] = int(rx_m.group(1))
                    if tx_m:
                        current_sock['tx'] = int(tx_m.group(1))
                continue

            parts = line.split()
            if len(parts) < 5 or parts[0].lower() in ('netid', 'state'):
                current_sock = None
                continue

            proto = parts[0].upper()
            state = parts[1].upper()
            recv_q = parts[2]
            send_q = parts[3]
            local_addr = parts[4]
            peer_addr = parts[5] if len(parts) > 5 and not parts[5].startswith('users:') else "*:*"

            user_matches = re.findall(r'\"([^\"]+)\",pid=(\d+)(?:,fd=(\d+))?', line)
            if not user_matches:
                current_sock = None
                continue

            app_name, pid_str, fd_str = user_matches[0]
            pid = int(pid_str)
            fd = fd_str if fd_str else "-"

            # Resolve service name if possible
            peer_port_match = re.search(r':(\d+)$', peer_addr)
            service_tag = ""
            if peer_port_match:
                p_num = int(peer_port_match.group(1))
                if p_num in PORT_SERVICES:
                    service_tag = f" ({PORT_SERVICES[p_num]})"

            is_local = (
                peer_addr.startswith("127.") or 
                peer_addr.startswith("::1") or 
                peer_addr.startswith("0.0.0.0") or 
                peer_addr.startswith("*") or
                peer_addr.startswith("[::1]") or
                peer_addr.startswith("[::]")
            )

            current_sock = {
                "proto": proto,
                "state": state,
                "local": local_addr,
                "peer": peer_addr + service_tag,
                "recv_q": recv_q,
                "send_q": send_q,
                "pid": pid,
                "fd": fd,
                "rx": 0,
                "tx": 0,
                "is_local": is_local
            }

            if app_name not in apps:
                apps[app_name] = {
                    "name": app_name,
                    "pids": set(),
                    "sockets": [],
                    "rss_bytes": 0,
                    "io_read_bytes": 0,
                    "io_write_bytes": 0,
                    "exe_path": "unknown",
                    "cmdline": "",
                    "net_rx": 0,
                    "net_tx": 0,
                    "net_total": 0,
                    "total_rx": 0,
                    "total_tx": 0,
                    "grand_total": 0
                }

            apps[app_name]["pids"].add(pid)
            apps[app_name]["sockets"].append(current_sock)

    except Exception:
        pass

    # Read /proc details for discovered processes and sum metrics
    for app_name, app_data in apps.items():
        # Sum network metrics
        app_data["total_rx"] = sum(s["rx"] for s in app_data["sockets"])
        app_data["total_tx"] = sum(s["tx"] for s in app_data["sockets"])
        app_data["net_rx"] = sum(s["rx"] for s in app_data["sockets"] if not s["is_local"])
        app_data["net_tx"] = sum(s["tx"] for s in app_data["sockets"] if not s["is_local"])
        app_data["net_total"] = app_data["net_rx"] + app_data["net_tx"]
        app_data["grand_total"] = app_data["total_rx"] + app_data["total_tx"]

        primary_pid = list(app_data["pids"])[0] if app_data["pids"] else None

        if primary_pid and os.path.exists(f"/proc/{primary_pid}"):
            try:
                app_data["exe_path"] = os.readlink(f"/proc/{primary_pid}/exe")
            except Exception:
                app_data["exe_path"] = "unknown"

            try:
                with open(f"/proc/{primary_pid}/cmdline", "r", encoding="utf-8", errors="ignore") as f:
                    app_data["cmdline"] = f.read().replace('\0', ' ').strip()
            except Exception:
                app_data["cmdline"] = app_name

        total_rss = 0
        total_read = 0
        total_write = 0
        for pid in app_data["pids"]:
            try:
                with open(f"/proc/{pid}/status", "r") as f:
                    for s_line in f:
                        if s_line.startswith("VmRSS:"):
                            parts = s_line.split()
                            if len(parts) >= 2:
                                total_rss += int(parts[1]) * 1024
                            break
            except Exception:
                pass

            try:
                with open(f"/proc/{pid}/io", "r") as f:
                    for io_line in f:
                        if io_line.startswith("read_bytes:"):
                            total_read += int(io_line.split()[1])
                        elif io_line.startswith("write_bytes:"):
                            total_write += int(io_line.split()[1])
            except Exception:
                pass

        app_data["rss_bytes"] = total_rss
        app_data["io_read_bytes"] = total_read
        app_data["io_write_bytes"] = total_write

    return apps

def update_apps_history(conn, apps_dict=None):
    """Updates daily bandwidth usage and active runtime duration for apps in SQLite app_daily_stats"""
    if apps_dict is None:
        apps_dict = get_process_network_info()

    today = datetime.now().strftime("%Y-%m-%d")
    now_ts = time.time()
    now_dt = datetime.now()
    midnight = now_dt.replace(hour=0, minute=0, second=0, microsecond=0)
    sec_since_midnight = max(1, int((now_dt - midnight).total_seconds()))

    c = conn.cursor()

    for app_name, app_data in apps_dict.items():
        curr_rx = app_data.get("net_rx", 0)
        curr_tx = app_data.get("net_tx", 0)
        if curr_rx == 0 and curr_tx == 0 and app_data.get("grand_total", 0) > 0:
            curr_rx = app_data.get("total_rx", 0)
            curr_tx = app_data.get("total_tx", 0)

        # Check app_state
        c.execute("SELECT last_rx, last_tx, last_seen FROM app_state WHERE app_name = ?", (app_name,))
        state_row = c.fetchone()

        if state_row is not None:
            last_rx, last_tx, last_seen = state_row
            delta_rx = (curr_rx - last_rx) if curr_rx >= last_rx else curr_rx
            delta_tx = (curr_tx - last_tx) if curr_tx >= last_tx else curr_tx
        else:
            delta_rx = curr_rx
            delta_tx = curr_tx

        # Calculate active runtime duration today
        pids = app_data.get("pids", set())
        app_running_seconds = 0
        if pids:
            max_runtime = max((get_pid_runtime(p) for p in pids), default=0)
            app_running_seconds = min(max_runtime, sec_since_midnight)

        # Get existing daily stats for today
        c.execute("SELECT active_seconds, last_seen FROM app_daily_stats WHERE date = ? AND app_name = ?", (today, app_name))
        daily_row = c.fetchone()

        if daily_row:
            old_active, old_seen = daily_row
            if app_running_seconds > old_active:
                new_active = app_running_seconds
            else:
                elapsed_since_seen = int(now_ts - old_seen) if old_seen else 0
                if 0 < elapsed_since_seen <= 600:
                    new_active = min(sec_since_midnight, old_active + elapsed_since_seen)
                else:
                    new_active = old_active
        else:
            new_active = app_running_seconds

        # Upsert app_daily_stats
        c.execute("""
            INSERT INTO app_daily_stats (date, app_name, rx, tx, active_seconds, last_seen)
            VALUES (?, ?, ?, ?, ?, ?)
            ON CONFLICT(date, app_name) DO UPDATE SET
            rx = rx + excluded.rx,
            tx = tx + excluded.tx,
            active_seconds = excluded.active_seconds,
            last_seen = excluded.last_seen
        """, (today, app_name, delta_rx, delta_tx, new_active, now_ts))

        # Update app_state
        c.execute("""
            INSERT INTO app_state (app_name, last_rx, last_tx, last_seen)
            VALUES (?, ?, ?, ?)
            ON CONFLICT(app_name) DO UPDATE SET
            last_rx = excluded.last_rx,
            last_tx = excluded.last_tx,
            last_seen = excluded.last_seen
        """, (app_name, curr_rx, curr_tx, now_ts))

    conn.commit()


