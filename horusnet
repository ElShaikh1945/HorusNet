def interactive_menu(conn):
    if get_config_val(conn, "language") is None:
        set_config_val(conn, "language", "en")

    selected_idx = 0
    sys.stdout.write(CURSOR_HIDE)
    sys.stdout.write(CLR_CLEAR_SCREEN)
    sys.stdout.flush()
    need_full_clear = False

    try:
        while True:
            branding = load_branding()
            th = get_theme(conn)
            tagline = branding.get(f"tagline_{get_lang(conn)}", branding["name"])

            menu_items = [
                ("1", f"[1] {t(conn, 'menu_summary')}", "summary"),
                ("2", f"[2] {t(conn, 'menu_daily')}", "daily"),
                ("3", f"[3] {t(conn, 'menu_monthly')}", "monthly"),
                ("4", f"[4] {t(conn, 'menu_hourly')}", "hourly"),
                ("5", f"[5] {t(conn, 'menu_apps')}", "apps"),
                ("6", f"[6] {t(conn, 'menu_interfaces')}", "interfaces"),
                ("7", f"[7] {t(conn, 'menu_live')}", "live"),
                ("8", f"[8] {t(conn, 'menu_export')}", "export"),
                ("9", f"[9] {t(conn, 'menu_settings')}", "settings"),
                ("0", f"[0] {t(conn, 'menu_exit')}", "exit")
            ]

            if need_full_clear:
                sys.stdout.write(CLR_CLEAR_SCREEN)
                need_full_clear = False

            buf = [CLR_HOME]

            # Draw ASCII Logo if enabled
            if branding.get("show_logo", True) and "ascii_logo" in branding:
                buf.append(f"{CLR_BOLD}{th['primary']}\n")
                for line in branding["ascii_logo"]:
                    buf.append(f"  {line}{CLR_CLEAR_LINE}\n")
                buf.append(f"{CLR_RESET}{CLR_CLEAR_LINE}\n")

            # App Title & Subtitle
            buf.append(f"{CLR_BOLD}{th['border']}╔═══════════════════════════════════════════════════════════╗{CLR_RESET}{CLR_CLEAR_LINE}\n")
            title_line = f"║             [ {branding['name']} - {tagline} ]"
            title_line = title_line[:59].ljust(59) + "║"
            buf.append(f"{CLR_BOLD}{th['primary']}{title_line}{CLR_RESET}{CLR_CLEAR_LINE}\n")
            buf.append(f"{CLR_BOLD}{th['border']}╚═══════════════════════════════════════════════════════════╝{CLR_RESET}{CLR_CLEAR_LINE}\n")
            buf.append(f"{th['dim']}  {t(conn, 'nav_hint')}{CLR_RESET}{CLR_CLEAR_LINE}\n\n")

            for idx, (_, label, _) in enumerate(menu_items):
                if idx == selected_idx:
                    buf.append(f"  {CLR_BOLD}{th['accent']}❯ {CLR_REVERSE} {label} {CLR_RESET}{CLR_CLEAR_LINE}\n")
                else:
                    buf.append(f"    {label}{CLR_CLEAR_LINE}\n")

            buf.append(f"\n{th['dim']}─────────────────────────────────────────────────────────────{CLR_RESET}{CLR_CLEAR_LINE}\n")
            sys.stdout.write("".join(buf))
            sys.stdout.flush()

            key = get_key()
            triggered_action = None

            if key == 'UP':
                selected_idx = (selected_idx - 1) % len(menu_items)
            elif key == 'DOWN':
                selected_idx = (selected_idx + 1) % len(menu_items)
            elif key in ('ESC', 'QUIT', 'CTRL_C'):
                break
            elif key.isdigit():
                for idx, (num, _, action) in enumerate(menu_items):
                    if num == key:
                        selected_idx = idx
                        triggered_action = action
                        break
            elif key in ('ENTER', 'SPACE'):
                triggered_action = menu_items[selected_idx][2]

            if triggered_action:
                action = triggered_action
                need_full_clear = True
                
                if action == "exit":
                    break

                if action == "settings":
                    settings_menu(conn)
                    continue

                if action == "export":
                    export_reports_menu(conn)
                    continue

                sys.stdout.write(CURSOR_SHOW)
                sys.stdout.write(CLR_CLEAR_SCREEN)
                sys.stdout.flush()

                if action == "summary":
                    show_summary(conn)
                    sys.stdout.write(CURSOR_HIDE)
                    should_continue = wait_for_enter_or_q(conn)
                    if not should_continue:
                        break
                elif action == "daily":
                    show_daily(conn, limit=14)
                    sys.stdout.write(CURSOR_HIDE)
                    should_continue = wait_for_enter_or_q(conn)
                    if not should_continue:
                        break
                elif action == "monthly":
                    show_monthly(conn)
                    sys.stdout.write(CURSOR_HIDE)
                    should_continue = wait_for_enter_or_q(conn)
                    if not should_continue:
                        break
                elif action == "hourly":
                    show_hourly(conn)
                elif action == "apps":
                    show_applications(conn)
                elif action == "interfaces":
                    show_interfaces(conn)
                    sys.stdout.write(CURSOR_HIDE)
                    should_continue = wait_for_enter_or_q(conn)
                    if not should_continue:
                        break
                elif action == "live":
                    live_monitor(conn)
                    sys.stdout.write(CURSOR_HIDE)
                    should_continue = wait_for_enter_or_q(conn)
                    if not should_continue:
                        break

    finally:
        sys.stdout.write(CURSOR_SHOW)
        sys.stdout.flush()
        th = get_theme(conn)
        print(f"\n{th['dim']}{t(conn, 'goodbye')}{CLR_RESET}\n")

