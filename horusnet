        buf.append(f"  {CLR_BOLD}{th['dim']}{t(conn, 'app_col_hash'):<4} {t(conn, 'app_col_name'):<16} {t(conn, 'app_col_down'):^12} {t(conn, 'app_col_up'):^12} {t(conn, 'app_col_total'):^14} {t(conn, 'app_col_runtime'):^16} {t(conn, 'app_col_status'):^8}{CLR_RESET}{CLR_CLEAR_LINE}\n")
        buf.append(f"  {th['dim']}" + "─" * 86 + f"{CLR_RESET}{CLR_CLEAR_LINE}\n")

        for idx, app in enumerate(apps_list):
            name_display = app['name'][:15]
            down_txt = format_bytes(app['today_rx'])
            up_txt = format_bytes(app['today_tx'])
            tot_txt = format_bytes(app['today_total'])
            dur_txt = format_duration(app['active_seconds'], get_lang(conn))
            status_txt = f"{th['accent']}{t(conn, 'app_status_active')}{CLR_RESET}" if app['is_running'] else f"{th['dim']}{t(conn, 'app_status_inactive')}{CLR_RESET}"

            item_line = f"[{idx+1:<2}] {name_display:<16} {down_txt:>10}   {up_txt:>10}   {tot_txt:>12}   {dur_txt:^16}   {status_txt:^8}"

            if idx == selected_idx:
                buf.append(f"  {CLR_BOLD}{th['accent']}❯ {CLR_REVERSE} {item_line} {CLR_RESET}{CLR_CLEAR_LINE}\n")
            else:
