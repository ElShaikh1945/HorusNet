    c.execute("""
        INSERT OR IGNORE INTO quota_config (id, enabled, period_type, cycle_start_day, total_limit_bytes, warn_threshold_percent, crit_threshold_percent, last_warned_level, last_warned_cycle, daily_limit_bytes, daily_warn_percent, last_warned_daily_date, last_warned_daily_level)
        VALUES (1, 0, 'monthly', 1, 150323855360, 80, 95, 0, '', 0, 80, '', 0)
