            buf.append(f"{th['dim']}{t(conn, 'press_enter_back')}{CLR_RESET}{CLR_CLEAR_LINE}\n")
            sys.stdout.write("".join(buf))
            sys.stdout.flush()
            wait_for_enter_or_q(conn)
            break

